# Canonical MetaHuman OS root.
M3TA_ROOT=~/MetaHu3manOS

# Local MCP/WebMCP server port. The host is intentionally fixed to 127.0.0.1.
M3TA_MCP_PORT=7337

# OpenAI-compatible oMLX endpoint.
M3TA_OMLX_BASE_URL=http://127.0.0.1:8000/v1

# Keep disabled until you want the connector to write the M0 audit artifact.
# M3TA_ENABLE_AUDIT_WRITE=1
